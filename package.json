{
  "name": "hablo",
  "version": "0.1.0",
  "private": true,
  "description": "A Spanish learning app built around evidence-based retention research, tuned to one learner's profile.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "smoke": "npm run build && node scripts/smoke.mjs",
    "smoke:shots": "npm run build && node scripts/smoke.mjs --shots",
    "icons": "node scripts/make-icons.mjs",
    "check": "npm run typecheck && npm test && npm run smoke"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dbl1124/duolingo-clone.git"
  },
  "license": "ISC",
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.0",
    "playwright": "^1.62.1",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
